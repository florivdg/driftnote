---
import "@/styles/driftnote.css";

interface Props {
  title?: string;
  sidebar?: "left" | "right";
}
const { title = "DriftNote", sidebar = "left" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body data-theme="dark" data-density="cozy" data-sidebar={sidebar}>
    {
      /* If this script body changes, rerun `bun scripts/csp-fouc-hash.ts` and
        update `security.csp.scriptDirective.hashes` in astro.config.mjs. */
    }
    <script is:inline>
      // FOUC-killer: apply persisted prefs before paint.
      try {
        const t = localStorage.getItem("driftnote_theme");
        if (t === "light" || t === "dark") document.body.dataset.theme = t;
        const d = localStorage.getItem("driftnote_density");
        if (d === "compact" || d === "cozy" || d === "airy")
          document.body.dataset.density = d;
        const s = localStorage.getItem("driftnote_sidebar");
        if (s === "left" || s === "right") document.body.dataset.sidebar = s;
      } catch (e) {
        /* localStorage unavailable */
      }
    </script>
    <slot />
  </body>
</html>
