---
import Layout from "@/layouts/Layout.astro";
import Masthead from "@/components/Masthead.astro";
import Sidebar from "@/components/islands/Sidebar.vue";
import StreamView from "@/components/islands/StreamView.vue";
import Composer from "@/components/islands/Composer.vue";
import {
  listIdeas,
  listTagsWithCounts,
  countIdeas,
  countUntagged,
  countTextOnly,
  countArchived,
  type StreamFilters,
} from "@/lib/ideas";
import { issueNumber } from "@/lib/issueNumber";
import { parseTags } from "@/lib/url";
import {
  parseDateParam,
  parseSortParam,
  parseSourceParam,
} from "@/lib/validation";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(
    `/login?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}

const sp = Astro.url.searchParams;
const q = sp.get("q") ?? "";
const activeTagNames = parseTags(sp.get("tags"));
const untagged = sp.get("untagged") === "1";
const source = parseSourceParam(sp.get("source")) ?? null;
const archived = sp.get("archived") === "1";
const from = parseDateParam(sp.get("from")) ?? null;
const to = parseDateParam(sp.get("to")) ?? null;
const sort = parseSortParam(sp.get("sort"));

const filters: StreamFilters = {
  q,
  tags: activeTagNames,
  untagged,
  source: source ?? undefined,
  archived,
  from: from ?? undefined,
  to: to ?? undefined,
  sort,
};

const [ideas, tagList] = await Promise.all([
  listIdeas(user.id, filters),
  listTagsWithCounts(user.id),
]);
const totalIdeas = countIdeas(user.id);
const untaggedCount = countUntagged(user.id);
const textCount = countTextOnly(user.id);
const archivedCount = countArchived(user.id);

const visibleTagCount = tagList.filter((t) => t.count > 0).length;
const suggestedTags = tagList
  .filter((t) => t.count > 0)
  .slice(0, 4)
  .map((t) => t.name);

const tagHueByName = new Map(tagList.map((t) => [t.name, t.hue]));
const activeTagHues = activeTagNames
  .map((name) => ({ name, hue: tagHueByName.get(name) }))
  .filter((t): t is { name: string; hue: number } => t.hue !== undefined);

const MO = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
const now = new Date();
const weekOf = `${MO[now.getMonth()]} ${now.getDate()}`;
const issueNo = String(issueNumber()).padStart(3, "0");

const filterState = {
  query: q,
  tags: activeTagNames,
  untagged,
  source,
  archived,
  from,
  to,
  sort,
};

const sidebarInitial = {
  tagList,
  totalIdeas,
  untaggedCount,
  textCount,
  archivedCount,
  ...filterState,
};

const streamInitial = {
  ideas,
  activeTagHues,
  ...filterState,
};
---

<Layout title="DriftNote">
  <div class="app">
    <Masthead
      user={user}
      ideaCount={totalIdeas}
      tagCount={visibleTagCount}
      query={q}
    />
    <Sidebar client:load initial={sidebarInitial} />
    <main id="main" class="stream-wrap" tabindex="-1">
      <div class="stream-inner">
        <section class="issue">
          <div class="issue-line">
            <span>DriftNote · No. {issueNo}</span>
            <span class="sep">·</span>
            <span>Week of {weekOf}</span>
          </div>
          <h1 class="issue-title">
            {totalIdeas} unfinished <em>thoughts</em>, waiting for you.
          </h1>
          <p class="issue-sub">
            Drop what's coming up — half-formed is welcome. Tag it now if you
            can, or let it sit and tag it later.
          </p>
        </section>

        <Composer client:load suggested={suggestedTags} />

        <StreamView client:load initial={streamInitial} />
      </div>
    </main>
  </div>
</Layout>
