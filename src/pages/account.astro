---
import Layout from "@/layouts/Layout.astro";
import Masthead from "@/components/Masthead.astro";
import ProfileForm from "@/components/islands/ProfileForm.vue";
import PasskeyList from "@/components/islands/PasskeyList.vue";
import SessionList from "@/components/islands/SessionList.vue";
import DangerZone from "@/components/islands/DangerZone.vue";
import { countIdeas, listTagsWithCounts } from "@/lib/ideas";
import { listPasskeys, listSessions } from "@/lib/account";
import { issueNumber } from "@/lib/issueNumber";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/account");
}

const [totalIdeas, tagList, passkeys, sessions] = await Promise.all([
  countIdeas(user.id),
  listTagsWithCounts(user.id),
  listPasskeys(user.id),
  listSessions(user.id),
]);
const visibleTagCount = tagList.filter((t) => t.count > 0).length;
const currentSessionId = Astro.locals.session?.id ?? null;

const issueNo = String(issueNumber()).padStart(3, "0");
const firstName = (user.name ?? user.email ?? "you").split(/\s+/)[0];
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout title="DriftNote · Account">
  <div class="account-shell">
    <Masthead
      user={user}
      ideaCount={totalIdeas}
      tagCount={visibleTagCount}
      query=""
    />
    <main id="main" class="account-stream" tabindex="-1">
      <div class="stream-inner">
        <section class="issue">
          <div class="issue-line">
            <span>DriftNote · Profile</span>
            <span class="sep">·</span>
            <span>No. {issueNo}</span>
            <span class="sep">·</span>
            <span>Signed in</span>
          </div>
          <h1 class="issue-title">
            On the masthead, <em>{firstName}</em>.
          </h1>
          <p class="issue-sub">
            Your bylines, your devices, your sessions — and the door out.
          </p>
        </section>

        <section class="account-section">
          <div class="account-section-label">
            <span>Bylines</span>
            <span class="account-section-count">02</span>
          </div>
          <ProfileForm
            client:load
            initialName={user.name ?? null}
            email={user.email ?? null}
          />
        </section>

        <section class="account-section">
          <div class="account-section-label">
            <span>Devices</span>
            <span class="account-section-count">{pad(passkeys.length)}</span>
          </div>
          <PasskeyList client:load initial={passkeys} />
        </section>

        <section class="account-section">
          <div class="account-section-label">
            <span>Sessions</span>
            <span class="account-section-count">{pad(sessions.length)}</span>
          </div>
          <SessionList
            client:load
            initial={sessions}
            currentId={currentSessionId}
          />
        </section>

        <section class="account-section">
          <div class="account-section-label">
            <span>Archive</span>
            <span class="account-section-count">{pad(totalIdeas)}</span>
          </div>
          <div class="account-export">
            <div class="account-export-text">
              <span class="account-export-title">take your data with you</span>
              <span class="account-export-sub">
                a complete, re-importable copy of every note and tag.
              </span>
            </div>
            <div class="account-export-actions">
              <a
                class="btn account-export-btn"
                href="/api/export"
                download
                rel="nofollow"
              >
                download json
              </a>
              <a
                class="btn account-export-btn"
                href="/api/export?format=md"
                download
                rel="nofollow"
              >
                download markdown
              </a>
            </div>
          </div>
        </section>

        <section class="account-section">
          <div class="account-section-label">
            <span>Departures</span>
            <span class="account-section-count">·</span>
          </div>
          <DangerZone client:load />
        </section>

        <div class="stream-end">
          <span>End of profile</span>
        </div>

        <p class="account-back">
          <a href="/">← back to stream</a>
        </p>
      </div>
    </main>
  </div>
</Layout>
