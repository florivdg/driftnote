---
import Layout from "@/layouts/Layout.astro";
import Masthead from "@/components/Masthead.astro";
import NoteDetail from "@/components/islands/NoteDetail.vue";
import { getIdeaById, countIdeas, listTagsWithCounts } from "@/lib/ideas";
import { relatedCards } from "@/lib/embeddings";
import { issueNumber } from "@/lib/issueNumber";
import { LOCALE } from "@/lib/time";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(
    `/login?next=${encodeURIComponent(Astro.url.pathname)}`,
  );
}

const id = Astro.params.id ?? "";
const idea = await getIdeaById(user.id, id);
if (!idea) {
  return new Response("Note not found", {
    status: 404,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}

const tagList = await listTagsWithCounts(user.id);
const totalIdeas = countIdeas(user.id);
const visibleTagCount = tagList.filter((t) => t.count > 0).length;

const issueNo = String(issueNumber()).padStart(3, "0");
const dated = new Date(idea.createdAt).toLocaleDateString(LOCALE, {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});
const preview = idea.body.replace(/\s+/g, " ").trim().slice(0, 80);

// Related notes are pure server-side KNN over the stored vectors — no browser
// model needed. Empty (renders nothing) until this note has been embedded by
// the on-device indexer, so a never-indexed note degrades gracefully.
const related = relatedCards(user.id, idea.id, 5);
const relatedItems = related.map((r) => ({
  id: r.id,
  preview: r.body.replace(/\s+/g, " ").trim().slice(0, 120) || "(empty note)",
}));
---

<Layout title={`DriftNote · ${preview || "Note"}`}>
  <div class="app">
    <Masthead
      user={user}
      ideaCount={totalIdeas}
      tagCount={visibleTagCount}
      query=""
    />
    <main id="main" class="stream-wrap" tabindex="-1">
      <div class="stream-inner">
        <section class="issue">
          <div class="issue-line">
            <a class="note-back" href="/">← back to stream</a>
            <span class="sep">·</span>
            <span>No. {issueNo}</span>
            <span class="sep">·</span>
            <span>{dated}</span>
          </div>
          <h1 class="issue-title">A single <em>thought</em>.</h1>
          <p class="issue-sub">
            Permalink — copy it, link it, or send it back to the stream.
          </p>
        </section>

        <NoteDetail client:load idea={idea} />

        {
          relatedItems.length > 0 && (
            <section class="related" data-testid="related-notes">
              <h2 class="related-title">Related</h2>
              <ul class="related-list">
                {relatedItems.map((r) => (
                  <li>
                    <a class="related-link" href={`/i/${r.id}`}>
                      {r.preview}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </main>
  </div>
</Layout>

<style>
  .note-back {
    color: var(--ink-3);
    transition: color 120ms ease;
  }
  .note-back:hover {
    color: var(--ink);
  }
  .note-detail {
    margin-top: 8px;
  }
  .related {
    margin-top: 32px;
  }
  .related-title {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 12px;
  }
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .related-link {
    display: block;
    color: var(--ink-2);
    line-height: 1.45;
    transition: color 120ms ease;
  }
  .related-link:hover {
    color: var(--ink);
  }
</style>
