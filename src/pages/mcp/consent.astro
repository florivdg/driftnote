---
import Layout from "@/layouts/Layout.astro";
import { db } from "@/lib/db/client";
import { oauthApplication } from "@/lib/db/auth-schema";
import { eq } from "drizzle-orm";

export const prerender = false;

const url = Astro.url;
const consentCode = url.searchParams.get("consent_code") ?? "";
const clientId = url.searchParams.get("client_id") ?? "";
const scope = url.searchParams.get("scope") ?? "";
const scopes = scope.split(" ").filter(Boolean);

const client = clientId
  ? db
      .select({ name: oauthApplication.name })
      .from(oauthApplication)
      .where(eq(oauthApplication.clientId, clientId))
      .get()
  : null;
const clientName = client?.name ?? clientId ?? "an unknown client";

const missingParams = !consentCode || !clientId;

const today = new Date()
  .toLocaleDateString(undefined, {
    year: "numeric",
    month: "short",
    day: "2-digit",
  })
  .toUpperCase();
const clientIdShort = clientId ? clientId.slice(0, 8) : "";
---

<Layout title="DriftNote · Authorize MCP client">
  <main id="main" class="consent-page" tabindex="-1">
    <article class="consent-card">
      {
        missingParams ? (
          <>
            <div class="consent-strip">
              <span>Consent</span>
              <span class="sep">·</span>
              <span>Invalid</span>
            </div>
            <h1 class="consent-title">
              This authorization link is <em>incomplete.</em>
            </h1>
            <div class="consent-foot">
              <a class="btn" href="/">
                Return home
              </a>
            </div>
          </>
        ) : (
          <>
            <div class="consent-strip">
              <span>Consent</span>
              <span class="sep">·</span>
              <span>{today}</span>
              <span class="sep">·</span>
              <span class="consent-strip-id">{clientIdShort}</span>
            </div>

            <h1 class="consent-title">
              <strong>{clientName}</strong> is{" "}
              <em>requesting access to your notebook.</em>
            </h1>

            <section class="consent-grants">
              <div class="consent-grants-label">Grants</div>
              <ul>
                {scopes.map((s) => (
                  <li>{s}</li>
                ))}
                <li>Read every note and tag you've saved</li>
              </ul>
            </section>

            <form
              method="POST"
              action="/api/oauth/consent"
              class="consent-decision"
              data-consent-form
            >
              <input type="hidden" name="consent_code" value={consentCode} />
              <button
                type="submit"
                name="accept"
                value="true"
                class="consent-approve"
              >
                Approve access
              </button>
              <button
                type="submit"
                name="accept"
                value="false"
                class="consent-deny"
              >
                Deny
              </button>
            </form>
            <p
              class="consent-error"
              data-consent-error
              role="alert"
              aria-live="polite"
              hidden
            />
          </>
        )
      }
    </article>
  </main>
</Layout>

<style>
  .consent-page {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background: var(--bg);
    overflow: auto;
    z-index: 10;
  }
  .consent-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--rule) 1px, transparent 1px);
    background-size: 1px 32px;
    pointer-events: none;
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 18%,
      black 82%,
      transparent 100%
    );
  }

  .consent-card {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 32px 36px 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: consent-in 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .consent-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    row-gap: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .consent-strip .sep {
    opacity: 0.4;
  }
  .consent-strip-id {
    color: var(--ink-2);
  }

  .consent-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .consent-title strong {
    font-weight: 400;
    font-style: normal;
  }
  .consent-title em {
    font-style: italic;
    color: var(--accent);
  }

  .consent-grants-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 8px;
  }
  .consent-grants ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ink);
  }
  .consent-grants li {
    padding: 8px 0;
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .consent-grants li::before {
    content: "";
    width: 4px;
    height: 4px;
    background: var(--ink-3);
    border-radius: 999px;
    flex-shrink: 0;
  }
  .consent-grants li:last-child {
    border-bottom: none;
  }

  .consent-decision {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
  }

  .consent-approve {
    width: 100%;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 18px 22px;
    cursor: pointer;
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--accent) 70%, black 30%),
      0 12px 28px color-mix(in oklch, var(--accent) 25%, transparent);
    transition:
      transform 140ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 140ms ease,
      background 140ms ease;
  }
  .consent-approve:hover {
    background: color-mix(in oklch, var(--accent) 92%, white 8%);
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--accent) 65%, black 35%),
      0 16px 36px color-mix(in oklch, var(--accent) 35%, transparent);
  }
  .consent-approve:active {
    transform: translateY(1px);
  }
  .consent-approve:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .consent-approve:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .consent-deny {
    background: none;
    border: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 6px 10px;
    cursor: pointer;
  }
  .consent-deny:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .consent-deny:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: var(--radius);
  }
  .consent-deny:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    text-decoration: none;
  }

  .consent-error {
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--hot);
  }

  .consent-foot {
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 540px) {
    .consent-card {
      padding: 24px 22px 20px;
      gap: 18px;
    }
    .consent-title {
      font-size: 28px;
    }
    .consent-approve {
      font-size: 12px;
      padding: 16px 18px;
    }
  }
</style>

<script>
  import { isAllowedRedirectUri } from "@/lib/url";

  // Intercept the consent submission so we can navigate to the cross-origin
  // OAuth callback via location.assign — keeps CSP `form-action 'self'` valid.
  const form = document.querySelector<HTMLFormElement>("[data-consent-form]");
  const errorEl = document.querySelector<HTMLElement>("[data-consent-error]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(event.submitter instanceof HTMLButtonElement)) return;

    const submitter = event.submitter;
    const buttons = form.querySelectorAll<HTMLButtonElement>(
      "button[type=submit]",
    );
    buttons.forEach((b) => (b.disabled = true));
    if (errorEl) {
      errorEl.hidden = true;
      errorEl.textContent = "";
    }

    const body = new FormData(form);
    body.set("accept", submitter.value);

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body,
        headers: { accept: "application/json" },
      });
      const data = (await res.json().catch(() => null)) as {
        redirectURI?: string;
        error?: string;
      } | null;
      if (!res.ok || !data?.redirectURI) {
        throw new Error(data?.error ?? `Request failed (${res.status})`);
      }
      if (!isAllowedRedirectUri(data.redirectURI)) {
        throw new Error("Invalid redirect URI");
      }
      window.location.assign(data.redirectURI);
    } catch (err) {
      buttons.forEach((b) => (b.disabled = false));
      if (errorEl) {
        errorEl.textContent =
          err instanceof Error ? err.message : "Submission failed.";
        errorEl.hidden = false;
      }
    }
  });
</script>
