---
import ThemeToggle from "./islands/ThemeToggle.vue";
import SearchInput from "./islands/SearchInput.vue";
import UserMenu from "./islands/UserMenu.vue";
import { MONTHS_SHORT, WEEKDAYS_SHORT } from "@/lib/time";

interface Props {
  user: { name?: string; email?: string } | null;
  ideaCount: number;
  tagCount: number;
  query: string;
}
const { user, ideaCount, tagCount, query } = Astro.props;

const now = new Date();
const dateStr = `${WEEKDAYS_SHORT[now.getDay()]} · ${MONTHS_SHORT[now.getMonth()]} ${now.getDate()}`;

function initials(u: { name?: string; email?: string } | null): string {
  if (!u) return "?";
  const n = (u.name ?? "").trim();
  if (n) {
    const parts = n.split(/\s+/).slice(0, 2);
    return parts.map((p) => p[0]!.toUpperCase()).join("");
  }
  return (u.email ?? "?")[0]!.toUpperCase();
}
const avatar = initials(user);
---

<header class="masthead">
  <div class="masthead-brand">DriftNote</div>
  <span class="masthead-meta">
    <span>{dateStr}</span>
    <span class="sep">·</span>
    <span>{ideaCount} ENTRIES</span>
    <span class="sep">·</span>
    <span>{tagCount} TAGS</span>
  </span>
  <span class="masthead-spacer"></span>

  <form class="masthead-search" method="get" action="/" role="search">
    <span>Search</span>
    <SearchInput client:load initial={query} />
    <span class="kbd">/</span>
  </form>

  <ThemeToggle client:load />

  {
    user ? (
      <UserMenu
        client:load
        name={user.name}
        email={user.email}
        initials={avatar}
      />
    ) : null
  }
</header>
