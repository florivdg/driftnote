---
interface Props {
  label: string;
  count: number;
}
const { label, count } = Astro.props;
---

<section class="day-group">
  <header class="day-header">
    <h2 class="day-title">
      {label}<span class="day-period">.</span>
    </h2>
    <span class="day-meta">
      <span class="day-count">{count}</span>
      <span>{count === 1 ? "entry" : "entries"}</span>
    </span>
  </header>
  <div class="stream">
    <slot />
  </div>
</section>
