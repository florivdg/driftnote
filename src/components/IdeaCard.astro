---
import type { IdeaWithTags } from "@/lib/ideas";
import { formatTime } from "@/lib/time";
import { TAG_PALETTE } from "@/lib/tags";
import { toggleTag } from "@/lib/url";

interface Props {
  idea: IdeaWithTags;
  index: number;
  url: URL;
}
const { idea, index, url } = Astro.props;

const num = String(index + 1).padStart(3, "0");
const primary = idea.tags[0];
const cardStyle = primary
  ? `--stripe: oklch(var(--tag-stripe-L) var(--tag-stripe-C) ${primary.hue}); --tint: oklch(var(--tag-tint-L) var(--tag-tint-C) ${primary.hue});`
  : "";

// Inline IdeaBody: split body on hashtags, color each.
const re = /(#[a-z][a-z0-9_-]*)/gi;
type Part = { kind: "t" | "h"; s: string; hue?: number };
const parts: Part[] = [];
let last = 0;
let m: RegExpExecArray | null;
while ((m = re.exec(idea.body)) !== null) {
  if (m.index > last)
    parts.push({ kind: "t", s: idea.body.slice(last, m.index) });
  const name = m[1].slice(1).toLowerCase();
  const linked = idea.tags.find((t) => t.name === name);
  const hue = linked?.hue ?? TAG_PALETTE[name]?.hue;
  parts.push({ kind: "h", s: m[1], hue });
  last = m.index + m[1].length;
}
if (last < idea.body.length)
  parts.push({ kind: "t", s: idea.body.slice(last) });
---

<article class="entry" style={cardStyle}>
  <div class="entry-top">
    <span class="entry-num">№{num}</span>
    <span class="entry-stamps">
      {
        idea.tags.map((t, i) => (
          <>
            {i > 0 && <span class="sep" />}
            <a
              class="stamp has-hue"
              style={`--hue: ${t.hue}`}
              href={toggleTag(url, t.name)}
              title={`Filter by #${t.name}`}
            >
              <span class="stamp-sq" />
              <span class="stamp-label">{t.name}</span>
            </a>
          </>
        ))
      }
    </span>
  </div>
  <div class="entry-body">
    {
      parts.map((p) =>
        p.kind === "t" ? (
          <span>{p.s}</span>
        ) : (
          <span
            class={"htag" + (p.hue !== undefined ? " has-hue" : "")}
            style={p.hue !== undefined ? `--hue: ${p.hue}` : ""}
          >
            {p.s}
          </span>
        ),
      )
    }
  </div>
  <div class="entry-foot">
    <span>{formatTime(idea.createdAt)}</span>
    <span class="dot-sep"></span>
    <span class={"source " + (idea.source === "voice" ? "voice" : "")}>
      {idea.source === "voice" ? "voice" : "typed"}
    </span>
  </div>
</article>
