---
import Chip from "./Chip.astro";
import { removeTag, setQuery, setFlag } from "@/lib/url";

interface Props {
  url: URL;
  activeTags: { name: string; hue?: number }[];
  query: string;
  untagged: boolean;
  source: "text" | "voice" | null;
}
const { url, activeTags, query, untagged, source } = Astro.props;

const hasAny = activeTags.length > 0 || query || untagged || source;
---

{
  hasAny && (
    <div class="filter-strip">
      <span class="filter-label">Filtering</span>
      <div class="chips">
        {activeTags.map((t) => (
          <Chip tag={t.name} hue={t.hue} removeHref={removeTag(url, t.name)} />
        ))}
        {query && (
          <span class="chip">
            <span class="chip-mark" />
            <span>&ldquo;{query}&rdquo;</span>
            <a class="x" href={setQuery(url, "")} aria-label="remove search">
              ×
            </a>
          </span>
        )}
        {untagged && (
          <span class="chip">
            <span class="chip-mark" />
            <span>untagged</span>
            <a
              class="x"
              href={setFlag(url, "untagged", null)}
              aria-label="remove untagged"
            >
              ×
            </a>
          </span>
        )}
        {source && (
          <span class="chip">
            <span class="chip-mark" />
            <span>{source} only</span>
            <a
              class="x"
              href={setFlag(url, "source", null)}
              aria-label="remove source filter"
            >
              ×
            </a>
          </span>
        )}
      </div>
      <a class="clear" href={url.pathname}>
        Clear
      </a>
    </div>
  )
}
