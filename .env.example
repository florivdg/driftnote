BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_BETTER_AUTH_URL=http://localhost:4321

# Local-only: skip the passkey ceremony and impersonate an existing user.
# Never set these in a real deployment. DRIFTNOTE_AUTH_BYPASS_EMAIL picks which
# user (defaults to the first row in the user table).
# DRIFTNOTE_AUTH_BYPASS=1
# DRIFTNOTE_AUTH_BYPASS_EMAIL=you@example.com
