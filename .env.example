BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# Note: there is no PUBLIC_BETTER_AUTH_URL. The browser auth client derives its
# base URL from window.location.origin, so app and /api/auth/* just need to
# share an origin. In production set BETTER_AUTH_URL to the real public origin —
# it is the OAuth issuer/resource base AND the passkey rpID.

# Local-only: skip the passkey ceremony and impersonate an existing user.
# Only takes effect when BETTER_AUTH_URL is localhost, so leaving it set can't
# disable auth on a real deployment. DRIFTNOTE_AUTH_BYPASS_EMAIL picks which user
# (defaults to the first row in the user table).
# DRIFTNOTE_AUTH_BYPASS=1
# DRIFTNOTE_AUTH_BYPASS_EMAIL=you@example.com
